[Unit]
Description=WW.CX Edge1 Operator fixed privileged broker
After=network.target
Before=edge1-operations-api.service

[Service]
Type=simple
User=root
Group=wwadmin
WorkingDirectory=/opt/edge1-management-interface
ExecStart=/usr/bin/python3 -m server.edge1_operator_privileged_broker
Restart=on-failure
RestartSec=3
RuntimeDirectory=edge1-operator-privileged
RuntimeDirectoryMode=0750
StateDirectory=edge1-operator-privileged
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/opt/edge1-management-interface

[Install]
WantedBy=multi-user.target
