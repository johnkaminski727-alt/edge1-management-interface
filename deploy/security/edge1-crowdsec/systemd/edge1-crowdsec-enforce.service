[Unit]
Description=Edge1 guarded CrowdSec input enforcement
Requires=ufw.service wg-quick@wg0.service edge1-crowdsec-bootstrap.service
After=ufw.service wg-quick@wg0.service edge1-crowdsec-bootstrap.service
Before=crowdsec-firewall-bouncer.service
ConditionPathExists=/etc/edge1/crowdsec/enforce.nft

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/edge1-crowdsec-enforce
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
