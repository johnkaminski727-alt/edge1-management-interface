#!/bin/bash
set -Eeuo pipefail

CONFIG=/etc/edge1/crowdsec/enforce.nft

systemctl is-active --quiet ufw.service
systemctl is-active --quiet wg-quick@wg0.service
systemctl is-active --quiet edge1-crowdsec-bootstrap.service
ip link show dev wg0 >/dev/null

# Verify the bootstrap tables and management guards before activation.
python3 - <<'PY'
import json
import subprocess

for family, table, blacklist in (
    ("ip", "crowdsec", "crowdsec-blacklists"),
    ("ip6", "crowdsec6", "crowdsec6-blacklists"),
):
    data = json.loads(subprocess.check_output(
        ["nft", "-j", "list", "table", family, table],
        text=True
    ))["nftables"]
    chains = [x["chain"] for x in data if "chain" in x]
    rules = [x["rule"] for x in data if "rule" in x]
    sets = [
        x["set"] for x in data
        if "set" in x and x["set"]["name"] == blacklist
    ]

    assert len(chains) == 1, "Unexpected existing chain"
    assert chains[0]["name"] == "edge1-guard"
    assert "hook" not in chains[0]
    assert len(rules) == 3
    assert len(sets) == 1
    assert "timeout" in sets[0].get("flags", [])
    print(f"PASS: {family} bootstrap state")
PY

cleanup() {
    echo "Enforcement activation failed; removing staged hooks"
    for spec in "ip crowdsec" "ip6 crowdsec6"; do
        if nft list chain $spec edge1-enforce-input >/dev/null 2>&1; then
            nft flush chain $spec edge1-enforce-input
            nft delete chain $spec edge1-enforce-input
        fi
    done
}
trap cleanup ERR

# This only installs the two input hooks.
# The bouncer is managed separately.
nft -f "$CONFIG"

python3 - <<'PY'
import json
import subprocess

for family, table in (
    ("ip", "crowdsec"),
    ("ip6", "crowdsec6"),
):
    data = json.loads(subprocess.check_output(
        ["nft", "-j", "list", "table", family, table],
        text=True
    ))["nftables"]
    chains = [x["chain"] for x in data if "chain" in x]
    guards = [c for c in chains if c["name"] == "edge1-guard"]
    hooks = [c for c in chains if c["name"] == "edge1-enforce-input"]

    assert len(guards) == 1
    assert len(hooks) == 1
    assert hooks[0].get("hook") == "input"
    assert hooks[0].get("prio") == -10
    print(f"PASS: {family} enforcement hook installed")
PY

trap - ERR
echo "PASS: Both enforcement hooks installed"
