[Unit]
Description=Audit current Edge1 security enforcement and observation baseline
After=edge1-crowdsec-observation.service wwcx-nftables-live-state.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/edge1-management-interface
ExecStart=/usr/bin/python3 -B /opt/edge1-management-interface/tools/automation/security_baseline_bot.py
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/edge1-status/security-baseline /var/lib/bigbird-ai-library
