[Unit]
Description=Edge1 Contacts verified discovery autopromotion
After=network.target edge1-operations-api.service edge1-contacts-maintenance.service
Wants=edge1-operations-api.service

[Service]
Type=oneshot
User=wwadmin
Group=wwadmin
WorkingDirectory=/opt/edge1-management-interface
Environment=PYTHONUNBUFFERED=1
LoadCredential=operations_api_secret:/etc/edge1-operations-api.secret
ExecStart=/usr/bin/python3 /opt/edge1-management-interface/tools/automation/contacts_verified_autopromote.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_UNIX
