[Unit]
Description=Edge1 DNS zone drift monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/edge1-management-interface/server/dns_zone_drift_monitor.py
User=root
Group=root
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/edge1-management-interface /var/lib/edge1-authoritative-dns
ReadWritePaths=/var/www/edge1-status
TimeoutStartSec=120
