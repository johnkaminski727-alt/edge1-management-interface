# Staging example only. Do not install until the live inventory, TLS virtual host,
# proxy modules, runtime service account, rollback, and route approval are verified.
# The consoles are served by the authenticated adapter; do not expose them with Alias.
ProxyPass        /edge1-ops/api/v1/snmp http://127.0.0.1:8108/edge1-ops/api/v1/snmp retry=0 timeout=90
ProxyPassReverse /edge1-ops/api/v1/snmp http://127.0.0.1:8108/edge1-ops/api/v1/snmp
# Canonicalize the human SNMP console URL before proxying.
RedirectMatch 302 ^/edge1-ops/snmp$ https://edge1.ww.cx/edge1-ops/snmp/
ProxyPass        /edge1-ops/snmp/ http://127.0.0.1:8108/edge1-ops/snmp/ retry=0 timeout=30
ProxyPassReverse /edge1-ops/snmp/ http://127.0.0.1:8108/edge1-ops/snmp/
ProxyPass        /edge1-ops/security/ http://127.0.0.1:8108/edge1-ops/security/ retry=0 timeout=20
ProxyPassReverse /edge1-ops/security/ http://127.0.0.1:8108/edge1-ops/security/
ProxyPass        /edge1-ops/session/exchange http://127.0.0.1:8108/edge1-ops/session/exchange retry=0 timeout=20
ProxyPassReverse /edge1-ops/session/exchange http://127.0.0.1:8108/edge1-ops/session/exchange
ProxyPass        /edge1-ops/session/logout http://127.0.0.1:8108/edge1-ops/session/logout retry=0 timeout=20
ProxyPassReverse /edge1-ops/session/logout http://127.0.0.1:8108/edge1-ops/session/logout
ProxyPass        /edge1-ops/session http://127.0.0.1:8108/edge1-ops/session retry=0 timeout=20
ProxyPassReverse /edge1-ops/session http://127.0.0.1:8108/edge1-ops/session
ProxyPass        /edge1-ops/api/v1/security/validate http://127.0.0.1:8108/edge1-ops/api/v1/security/validate retry=0 timeout=30
ProxyPassReverse /edge1-ops/api/v1/security/validate http://127.0.0.1:8108/edge1-ops/api/v1/security/validate

RequestHeader set X-Forwarded-Proto "https"
