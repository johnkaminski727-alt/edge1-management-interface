[Unit]
Description=Read-only Mail Room and domain health aggregator
After=wwcx-mail-readiness.service edge1-email-gateway-status-export.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/edge1-management-interface
ExecStart=/usr/bin/python3 -B /opt/edge1-management-interface/tools/automation/mail_domain_health_bot.py
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/edge1-status/mail-domain-health /var/lib/bigbird-ai-library
