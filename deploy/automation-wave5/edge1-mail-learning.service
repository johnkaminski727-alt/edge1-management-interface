[Unit]
Description=Summarize Mail Room security learning and quarantine patterns
After=wwcx-mail-security-scan.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/edge1-management-interface
ExecStart=/usr/bin/python3 -B /opt/edge1-management-interface/tools/automation/mail_learning_intelligence_bot.py
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/edge1-status/mail-learning /var/lib/bigbird-ai-library
