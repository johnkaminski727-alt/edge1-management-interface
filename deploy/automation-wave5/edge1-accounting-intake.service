[Unit]
Description=Stage invoice and accounting evidence from filed documents
After=edge1-document-filing.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/edge1-management-interface
ExecStart=/usr/bin/python3 -B /opt/edge1-management-interface/tools/automation/accounting_intake_bot.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/edge1-accounting-intake /var/www/edge1-status/accounting-intake /var/lib/bigbird-ai-library
