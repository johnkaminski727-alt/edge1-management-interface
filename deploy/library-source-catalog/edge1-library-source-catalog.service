[Unit]
Description=Edge1 Unified Private Library Source Catalog reconciler
After=local-fs.target edge1-private-library-search.service
Wants=edge1-private-library-search.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/edge1-management-interface
ExecStart=/usr/bin/python3 -B /opt/edge1-management-interface/tools/private_library/library_source_catalog.py
UMask=0027
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/bigbird-ai-library /var/www/edge1-status/library-source-catalog
