[Unit]
Description=Edge1 Private Library accounting document extractor
After=edge1-library-source-catalog.service

[Service]
Type=oneshot
User=wwadmin
Group=wwadmin
WorkingDirectory=/opt/edge1-management-interface
ExecStart=/opt/edge1-management-interface/.venv-evidence-extractor/bin/python -B /opt/edge1-management-interface/tools/automation/library_accounting_extractor.py --limit 500
UMask=0027
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/bigbird-ai-library/catalog /var/www/edge1-status/library-accounting
