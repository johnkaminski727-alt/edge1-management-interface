[Unit]
Description=Stage Edge1 package update reboot and failed-unit maintenance readiness
After=apt-daily.service apt-daily-upgrade.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/edge1-management-interface
ExecStart=/usr/bin/python3 -B /opt/edge1-management-interface/tools/automation/update_readiness_bot.py
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/edge1-status/update-readiness /var/lib/bigbird-ai-library
