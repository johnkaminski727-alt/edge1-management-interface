[Unit]
Description=Publish Ava weekly executive operations briefing
Wants=edge1-outstanding-actions.service edge1-backup-verification.service edge1-drift-monitor.service edge1-document-filing.service edge1-certificate-expiry.service edge1-storage-health.service
After=edge1-outstanding-actions.service edge1-backup-verification.service edge1-drift-monitor.service edge1-document-filing.service edge1-certificate-expiry.service edge1-storage-health.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/edge1-management-interface
ExecStart=/usr/bin/python3 -B /opt/edge1-management-interface/tools/automation/weekly_executive_briefing.py
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/edge1-status/executive-briefing /var/lib/bigbird-ai-library
