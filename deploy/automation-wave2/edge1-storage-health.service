[Unit]
Description=Read-only Edge1 storage and database health maintenance scan
After=local-fs.target
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/edge1-management-interface
ExecStart=/usr/bin/python3 -B /opt/edge1-management-interface/tools/automation/storage_database_health_bot.py
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/edge1-status/storage-health /var/lib/bigbird-ai-library
