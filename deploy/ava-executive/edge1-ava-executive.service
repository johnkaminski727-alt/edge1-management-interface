[Unit]
Description=AVA Executive Orchestrator team reconciliation
After=edge1-automation-inventory.service
[Service]
Type=oneshot
User=wwadmin
Group=wwadmin
WorkingDirectory=/opt/edge1-management-interface
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -B /opt/edge1-management-interface/tools/automation/ava_executive_orchestrator.py
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wwcx-ava-office-manager /var/www/edge1-status/ava
RestrictAddressFamilies=AF_UNIX
