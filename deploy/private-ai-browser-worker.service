[Unit]
Description=WW.CX Private AI browser pull worker
After=network-online.target bigbird-ai-gateway.service
Wants=network-online.target
Requires=bigbird-ai-gateway.service

[Service]
Type=simple
User=bigbird-ai
Group=bigbird-ai
WorkingDirectory=/opt/wwcx-private-ai-browser-worker/current
EnvironmentFile=/etc/wwcx/private-ai-browser-worker.env
ExecStart=/usr/bin/python3 /opt/wwcx-private-ai-browser-worker/current/private_ai_browser_worker.py
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/wwcx-private-ai-browser-worker
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077

[Install]
WantedBy=multi-user.target
