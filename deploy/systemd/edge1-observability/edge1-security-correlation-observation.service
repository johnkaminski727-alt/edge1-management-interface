[Unit]
Description=Read-only Edge1 Security Correlation observation
After=crowdsec.service

[Service]
Type=oneshot
User=root
ExecStartPre=/usr/bin/python3 /opt/edge1-management-interface/server/security_operations_exporter.py
ExecStart=/usr/local/sbin/edge1-security-correlation-observation
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/edge1-status
ProtectHome=true
PrivateTmp=true
TimeoutStartSec=90
