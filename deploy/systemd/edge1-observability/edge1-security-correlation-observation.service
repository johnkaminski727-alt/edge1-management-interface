[Unit]
Description=Read-only Edge1 Security Correlation observation
After=crowdsec.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/edge1-security-correlation-observation
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/edge1-status
ProtectHome=true
PrivateTmp=true
TimeoutStartSec=90
