[Unit]
Description=WW.CX sync VPN enrollment devices into registration state
After=edge1-operations-api.service edge1-vpn-enroll.service
Wants=edge1-operations-api.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/edge1-management-interface
ExecStart=/usr/bin/python3 /opt/edge1-management-interface/server/vpn_enrollment_registration_sync.py
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/edge1-management-interface /etc/edge1-operations-api.secret
# Enrollment SQLite is WAL-backed; the reader needs the directory writable for shm/lock state.
ReadWritePaths=/var/lib/edge1-vpn-enroll
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
