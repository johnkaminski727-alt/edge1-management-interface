[Unit]
Description=Edge1 Navigation Management API
After=network.target edge1-navigation-export.service

[Service]
Type=simple
User=wwadmin
Group=wwadmin
ExecStart=/usr/local/sbin/edge1-navigation-admin-http
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/edge1-navigation
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
