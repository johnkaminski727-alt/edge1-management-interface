[Unit]
Description=WW.CX Edge1 passive network sensor - Zeek metadata
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/default/wwcx-network-sensor

[Service]
Type=simple
User=wwsensor
Group=wwsensor
EnvironmentFile=/etc/default/wwcx-network-sensor
ExecStartPre=+/usr/bin/install -d -o root -g root -m 0755 /var/log/wwcx-network-sensor
ExecStartPre=+/usr/bin/install -d -o wwsensor -g root -m 2770 /var/log/wwcx-network-sensor/zeek
ExecStartPre=+/usr/bin/install -d -o root -g root -m 0755 /var/lib/wwcx-network-sensor
ExecStartPre=+/usr/bin/install -d -o wwsensor -g root -m 2770 /var/lib/wwcx-network-sensor/extracted
ExecStart=/usr/local/libexec/wwcx-network-sensor-zeek.sh
Restart=on-failure
RestartSec=5s
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/wwcx-network-sensor/zeek /var/lib/wwcx-network-sensor/extracted
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
