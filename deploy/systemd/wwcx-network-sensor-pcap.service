[Unit]
Description=WW.CX Edge1 passive network sensor - rotating full PCAP
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/default/wwcx-network-sensor

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/default/wwcx-network-sensor
ExecStartPre=/usr/bin/install -d -o root -g root -m 0755 /var/lib/wwcx-network-sensor
ExecStartPre=/usr/bin/install -d -o wwsensor -g root -m 2770 /var/lib/wwcx-network-sensor/pcap
ExecStartPre=/usr/bin/install -d -o wwsensor -g root -m 2770 /var/lib/wwcx-network-sensor/extracted
ExecStart=/usr/local/libexec/wwcx-network-sensor-pcap.sh
Restart=on-failure
RestartSec=5s
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wwcx-network-sensor
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
