[Unit]
Description=Edge1 staged guarded Spamhaus pinned-candidate restore
Documentation=file:/opt/edge1-management-interface/docs/security/spamhaus-guarded-boot-restore-a240.md
Wants=network-online.target
Requires=chrony.service ssh.service ufw.service crowdsec.service crowdsec-firewall-bouncer.service
After=local-fs.target network-online.target chrony.service ssh.service ufw.service crowdsec.service crowdsec-firewall-bouncer.service
ConditionPathExists=/var/lib/edge1-spamhaus/boot-candidate/spamhaus-candidate.nft
ConditionPathExists=/usr/local/libexec/edge1-spamhaus/spamhaus_guarded_boot_restore.py
ConditionPathExists=/usr/local/libexec/edge1-spamhaus/spamhaus_scoped_recovery.py

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/var/lib/edge1-spamhaus/boot-candidate
# Explicit, narrowly scoped access required by systemd-run's system-manager connection.
# Review sandbox compatibility with systemd-run before any staging or deployment.
ExecStart=/usr/bin/python3 -B /usr/local/libexec/edge1-spamhaus/spamhaus_guarded_boot_restore.py --execute
TimeoutStartSec=240

# STAGING ONLY: no [Install] section. Do not install, start, or enable yet.
