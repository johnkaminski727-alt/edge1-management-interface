[Unit]
Description=WW.CX Edge1 release-controller read-only status snapshot
After=network-online.target edge1-operations-api.service edge1-operator-mcp.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/edge1-release-controller status --write-status --publish-status
StateDirectory=edge1-release-controller
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=-/opt/edge1-management-source -/opt/edge1-runtime
ReadWritePaths=/var/lib/edge1-release-controller /var/www/edge1-status/release-manager
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
