# Staged Phase B2 template only. Do not install without explicit authorization.
# Replace the uppercase placeholders with an approved hostname, certificate paths,
# and the smallest possible source CIDR. The gateway remains on 127.0.0.1:8104.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name PREPARATION_API_HOSTNAME;

    ssl_certificate CERTIFICATE_FULLCHAIN_PATH;
    ssl_certificate_key CERTIFICATE_PRIVATE_KEY_PATH;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    client_max_body_size 320k;
    server_tokens off;

    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    location = /outbound-mail/api/v1/status {
        allow PREPARATION_CLIENT_CIDR;
        deny all;
        limit_except GET { deny all; }

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_pass http://127.0.0.1:8104;
        proxy_redirect off;
    }

    location = /outbound-mail/api/v1/prepare {
        allow PREPARATION_CLIENT_CIDR;
        deny all;
        limit_except POST { deny all; }

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_pass http://127.0.0.1:8104;
        proxy_redirect off;
    }

    location / {
        return 404;
    }
}
