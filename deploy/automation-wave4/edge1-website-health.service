[Unit]
Description=Read-only public website health monitor
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/edge1-management-interface
ExecStart=/usr/bin/python3 -B /opt/edge1-management-interface/tools/automation/website_health_bot.py
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/edge1-status/website-health /var/lib/bigbird-ai-library
