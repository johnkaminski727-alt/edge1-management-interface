[Unit]
Description=Classify and stage clean Mail Room documents for Ava
After=edge1-mail-contact-intake.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/edge1-management-interface
ExecStart=/usr/bin/python3 -B /opt/edge1-management-interface/tools/automation/document_filing_bot.py --limit 1000
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/edge1-document-filing /var/lib/bigbird-ai-library /var/www/edge1-status/document-filing
