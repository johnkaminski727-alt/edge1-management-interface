[Unit]
Description=Audit Edge1 background automation freshness and execution health
After=edge1-automation-inventory.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/edge1-management-interface
ExecStart=/usr/bin/python3 -B /opt/edge1-management-interface/tools/automation/automation_watchdog_bot.py
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/edge1-status/automation-watchdog /var/lib/bigbird-ai-library
