[Unit]
Description=Track new persistent and resolved Outstanding Actions
After=edge1-outstanding-actions.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/edge1-management-interface
ExecStart=/usr/bin/python3 -B /opt/edge1-management-interface/tools/automation/action_lifecycle_bot.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/edge1-action-lifecycle /var/www/edge1-status/action-lifecycle /var/lib/bigbird-ai-library
