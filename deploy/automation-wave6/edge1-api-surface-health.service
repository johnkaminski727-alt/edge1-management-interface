[Unit]
Description=Audit Edge1 API listener service and exposure drift
After=edge1-api-directory.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/edge1-management-interface
ExecStart=/usr/bin/python3 -B /opt/edge1-management-interface/tools/automation/api_surface_health_bot.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/edge1-api-surface-health /var/www/edge1-status/api-surface-health /var/lib/bigbird-ai-library
