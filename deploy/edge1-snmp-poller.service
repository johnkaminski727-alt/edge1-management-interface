[Unit]
Description=WW.CX Edge1 SNMP polling, interface, alerting and retention cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=wwadmin
Group=wwadmin
WorkingDirectory=/usr/local/libexec/edge1-snmp
Environment=EDGE1_SNMP_DB=/var/lib/edge1-snmp/snmp.sqlite3
Environment=EDGE1_SNMP_CONFIG=/etc/edge1-snmp/config.json
Environment=EDGE1_SNMP_PROFILE_DIR=/etc/edge1-snmp/profiles
Environment=EDGE1_SNMP_STATUS_OUTPUT=/var/www/edge1-status/snmp/operations-snmp.json
ExecStart=/usr/bin/python3 /usr/local/libexec/edge1-snmp/edge1_snmp_cycle.py
ExecStartPost=/usr/bin/python3 /usr/local/libexec/edge1-snmp/operations_snmp_exporter.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/usr/local/libexec/edge1-snmp /etc/edge1-snmp
ReadWritePaths=/var/lib/edge1-snmp /var/www/edge1-status/snmp
UMask=0077
