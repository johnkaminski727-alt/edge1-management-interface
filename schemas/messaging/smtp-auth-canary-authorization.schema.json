{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ww.cx/schemas/messaging/smtp-auth-canary-authorization.schema.json",
  "title": "WW.CX SMTP authentication-only canary authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "authentication_canary_authorized",
    "provider_profile",
    "expected_host_sha256",
    "expected_port",
    "expected_username_sha256",
    "expires_at",
    "mail_from_authorized",
    "recipient_authorized",
    "message_authorized"
  ],
  "properties": {
    "contract": {"const": "wwcx.smtp-auth-canary-authorization.v1"},
    "authentication_canary_authorized": {"const": true},
    "provider_profile": {"const": "smtp_submission"},
    "expected_host_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "expected_username_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expires_at": {"type": "string", "format": "date-time"},
    "mail_from_authorized": {"const": false},
    "recipient_authorized": {"const": false},
    "message_authorized": {"const": false}
  }
}
