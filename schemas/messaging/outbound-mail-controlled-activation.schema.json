{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ww.cx/schemas/messaging/outbound-mail-controlled-activation.schema.json",
  "title": "WW.CX controlled outbound-mail activation authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "provider_profile",
    "sender_identity_key",
    "sender_address",
    "runtime_config_sha256",
    "runtime_policy_sha256",
    "runtime_identities_sha256",
    "smtp_auth_canary_sha256",
    "pilot_recipient_sha256",
    "pilot_payload_sha256",
    "expires_at",
    "smtp_authentication_verified",
    "sender_provider_capability_verified",
    "dkim_dns_verified",
    "dmarc_monitoring_published",
    "aggregate_report_mailbox_ready",
    "bounce_ingestion_ready",
    "complaint_ingestion_ready",
    "suppression_gate_ready",
    "owned_recipient_verified",
    "activation_authorized",
    "one_message_authorized",
    "max_recipient_count",
    "rollback_required",
    "bulk_authorized",
    "commercial_authorized",
    "regulatory_authorized",
    "emergency_authorized"
  ],
  "properties": {
    "contract": {"const": "wwcx.outbound-mail-controlled-activation.v1"},
    "provider_profile": {"const": "smtp_submission"},
    "sender_identity_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,159}$"},
    "sender_address": {"type": "string", "format": "email", "maxLength": 320},
    "runtime_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_identities_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "smtp_auth_canary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pilot_recipient_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pilot_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expires_at": {"type": "string", "format": "date-time"},
    "smtp_authentication_verified": {"const": true},
    "sender_provider_capability_verified": {"const": true},
    "dkim_dns_verified": {"const": true},
    "dmarc_monitoring_published": {"const": true},
    "aggregate_report_mailbox_ready": {"const": true},
    "bounce_ingestion_ready": {"const": true},
    "complaint_ingestion_ready": {"const": true},
    "suppression_gate_ready": {"const": true},
    "owned_recipient_verified": {"const": true},
    "activation_authorized": {"const": true},
    "one_message_authorized": {"const": true},
    "max_recipient_count": {"const": 1},
    "rollback_required": {"const": true},
    "bulk_authorized": {"const": false},
    "commercial_authorized": {"const": false},
    "regulatory_authorized": {"const": false},
    "emergency_authorized": {"const": false}
  }
}
