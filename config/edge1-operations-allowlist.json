{
  "version": 5,
  "actions": {
    "repository.status": {"argv": ["git", "status", "--short", "--branch"], "mutating": false, "timeout_seconds": 30},
    "repository.head": {"argv": ["git", "rev-parse", "HEAD"], "mutating": false, "timeout_seconds": 30},
    "repository.fetch": {"argv": ["git", "fetch", "--prune", "origin"], "mutating": true, "timeout_seconds": 120},
    "repository.fast_forward_main": {"argv": ["git", "pull", "--ff-only", "origin", "main"], "mutating": true, "timeout_seconds": 180},
    "edge1.snapshot": {"argv": ["python3", "server/edge1_snapshot.py", "--format", "json"], "mutating": false, "timeout_seconds": 180},
    "validation.interconnect": {"argv": ["sh", "deploy/interconnect/validate-staging-assets.sh"], "mutating": false, "timeout_seconds": 300},
    "validation.numbering_node": {"argv": ["python3", "-m", "unittest", "discover", "-s", "tests", "-p", "test_wwcx_numbering_node.py", "-v"], "mutating": false, "timeout_seconds": 300},
    "numbering.health": {"argv": ["curl", "-fsS", "http://127.0.0.1:8093/healthz"], "mutating": false, "timeout_seconds": 30},
    "telephony.health": {"argv": ["curl", "-fsS", "http://127.0.0.1:8096/api/telephony/status"], "mutating": false, "timeout_seconds": 30},
    "telephony.console.control_status": {"argv": ["python3", "server/telephony_console_control_status.py"], "mutating": false, "timeout_seconds": 30},
    "telephony.console.reload_safe": {"typed_handler": "telephony_console_reload", "mutating": true, "mutation_gate": "telephony_safe_controls", "timeout_seconds": 60},
    "bigbird.health": {"argv": ["curl", "-fsS", "http://127.0.0.1:8787/v1/health"], "mutating": false, "timeout_seconds": 30},
    "bigbird.tools": {"argv": ["curl", "-fsS", "http://127.0.0.1:8787/v1/tools"], "mutating": false, "timeout_seconds": 30},
    "messaging.health": {"argv": ["curl", "-fsS", "http://127.0.0.1:58080/healthz"], "mutating": false, "timeout_seconds": 30},
    "time_authority.summary": {"argv": ["python3", "server/time_authority_summary.py"], "mutating": false, "timeout_seconds": 30},
    "control_surfaces.summary": {"argv": ["python3", "server/control_surface_diagnostics.py", "summary"], "mutating": false, "timeout_seconds": 45},
    "control_surfaces.listeners": {"argv": ["python3", "server/control_surface_diagnostics.py", "listeners"], "mutating": false, "timeout_seconds": 30},
    "system.services": {"argv": ["systemctl", "--no-pager", "--plain", "list-units", "--type=service", "--state=running,failed"], "mutating": false, "timeout_seconds": 30},
    "network.addresses": {"argv": ["ip", "-json", "address", "show"], "mutating": false, "timeout_seconds": 30},
    "network.routes": {"argv": ["ip", "-json", "route", "show", "table", "all"], "mutating": false, "timeout_seconds": 30},
    "disk.state": {"argv": ["df", "-P", "-T", "/", "/var", "/opt"], "mutating": false, "timeout_seconds": 30},
    "apache.status": {"argv": ["systemctl", "show", "apache2", "-p", "Id", "-p", "LoadState", "-p", "ActiveState", "-p", "SubState", "-p", "UnitFileState", "-p", "MainPID", "-p", "ExecMainStatus"], "mutating": false, "timeout_seconds": 30},
    "asterisk.diagnostics": {"argv": ["python3", "server/asterisk_operator_diagnostics.py"], "mutating": false, "timeout_seconds": 120},
    "kamailio.diagnostics": {"argv": ["python3", "server/control_surface_diagnostics.py", "kamailio"], "mutating": false, "timeout_seconds": 90},
    "freepbx.diagnostics": {"argv": ["python3", "server/control_surface_diagnostics.py", "freepbx"], "mutating": false, "timeout_seconds": 90},
    "config.digest": {"argv": ["sha256sum", "config/edge1-operations-allowlist.json", "config/edge1-operator-capabilities.json", "deploy/edge1-operations-api.service", "deploy/edge1-operator/edge1-operator-mcp.service", "server/edge1_operator_mcp_protocol.py", "server/edge1_operator_entrypoint.py", "server/edge1_operator_capabilities.py", "server/edge1_operations_typed_actions.py", "server/telephony_console_control_status.py", "server/asterisk_readonly_snapshot.py", "server/asterisk_operator_diagnostics.py", "deploy/systemd/edge1-asterisk-readonly-snapshot.service", "deploy/systemd/edge1-asterisk-readonly-snapshot.timer"], "mutating": false, "timeout_seconds": 30},
    "security.validate_config": {"argv": ["bash", "tools/security/validate-suricata.sh"], "mutating": false, "timeout_seconds": 300},
    "security.logs.rotate": {"argv": ["bash", "tools/security/rotate-suricata-logs.sh"], "mutating": true, "timeout_seconds": 120},
    "security.rules.reload": {"argv": ["bash", "tools/security/reload-suricata-rules.sh"], "mutating": true, "timeout_seconds": 120}
  }
}
