{
  "base_url": "http://127.0.0.1:8097",
  "connector": "bigbird-edge1",
  "disabled_tools": [
    "apache.status",
    "asterisk.diagnostics",
    "bigbird.health",
    "bigbird.tools",
    "config.digest",
    "control_surfaces.listeners",
    "control_surfaces.summary",
    "disk.state",
    "edge1.snapshot",
    "freepbx.diagnostics",
    "kamailio.diagnostics",
    "messaging.health",
    "network.addresses",
    "network.routes",
    "repository.fast_forward_main",
    "repository.fetch",
    "repository.head",
    "security.logs.rotate",
    "security.rules.reload",
    "system.services",
    "time_authority.summary"
  ],
  "enabled_tools": [
    "repository.status",
    "security.validate_config",
    "validation.interconnect",
    "validation.numbering_node",
    "numbering.health",
    "telephony.health"
  ],
  "mode": "read_only",
  "restart_policy": {
    "increment_minutes": 10,
    "initial_interval_minutes": 360,
    "maximum_interval_minutes": 720,
    "restart_scope": "connector_only"
  },
  "version": 1
}
