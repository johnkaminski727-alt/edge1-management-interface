# Installed as /etc/default/wwcx-network-sensor by the installer.
SENSOR_INTERFACE=CHANGE_ME
SENSOR_PROFILE=owner-full
SURICATA_CONFIG=/etc/suricata/suricata.yaml
SURICATA_CAPTURE_ARGUMENT=--af-packet=CHANGE_ME
PCAP_ROTATE_SECONDS=3600
PCAP_RETENTION_DAYS=7
PCAP_MAX_GB=250
EXTRACTED_RETENTION_DAYS=14
METADATA_RETENTION_DAYS=90
ENABLE_SURICATA=yes
ENABLE_PCAP=yes
ENABLE_ZEEK=no
