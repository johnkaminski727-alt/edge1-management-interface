{
  "server_name": "edge1.ww.cx",
  "network_name": "WW.CX",
  "database_path": "/var/lib/wwcx-comms/comms.sqlite3",
  "network_exposure": {"enabled": false},
  "listeners": {
    "irc": {"enabled": true, "host": "127.0.0.1", "port": 16667, "tls": false, "cert_file": null, "key_file": null},
    "nntp": {"enabled": true, "host": "127.0.0.1", "port": 1119, "tls": false, "cert_file": null, "key_file": null},
    "control": {"enabled": true, "host": "127.0.0.1", "port": 8100, "tls": false, "cert_file": null, "key_file": null}
  },
  "security": {
    "require_auth": true,
    "allow_anonymous_irc": false,
    "allow_anonymous_nntp_read": false,
    "allow_anonymous_nntp_post": false,
    "max_line_bytes": 8192,
    "max_article_bytes": 1048576,
    "password_iterations": 600000,
    "min_password_length": 12,
    "idle_timeout_seconds": 300,
    "max_connections": 128,
    "max_connections_per_ip": 16,
    "command_rate_per_second": 20,
    "command_burst": 40,
    "auth_failures_per_minute": 10
  },
  "retention": {
    "irc_history_enabled": false,
    "irc_history_days": 30,
    "default_news_days": 3650,
    "audit_days": 365,
    "maintenance_interval_seconds": 3600
  },
  "ingestion": {
    "enabled": true,
    "startup_delay_seconds": 5,
    "interval_seconds": 900,
    "max_items_per_run": 25,
    "sources": [
      {
        "type": "bootstrap",
        "name": "wwcx-bootstrap",
        "enabled": true,
        "initial_items": 8,
        "scan_limit": 500
      },
      {
        "type": "git",
        "name": "edge1-repository",
        "enabled": true,
        "group": "wwcx.projects.edge1",
        "path": "/opt/edge1-management-interface",
        "ref": "main",
        "base_url": "https://github.com/johnkaminski727-alt/edge1-management-interface",
        "initial_items": 8,
        "scan_limit": 500
      }
    ]
  }
}
