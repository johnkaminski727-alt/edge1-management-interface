  "workflows": [
    {
      "id": "provider-evidence-processing",
      "name": "Provider Evidence Processing",
      "autonomous": true,
      "trigger": "library-provider-change",
      "description": "Bring changed external-source material through catalog, evidence search, Contacts and accounting processing.",
      "steps": [
        {
          "id": "poll",
          "capability": "library.provider.poll_all",
          "depends_on": []
        },
        {
          "id": "catalog",
          "capability": "library.catalog.refresh",
          "depends_on": [
            "poll"
          ]
        },
        {
          "id": "index",
          "capability": "library.evidence.index",
          "depends_on": [
            "catalog"
          ]
        },
        {
          "id": "contacts",
          "capability": "evidence.contacts.intake",
          "depends_on": [
            "catalog"
          ]
        },
        {
          "id": "accounting",
          "capability": "accounting.extract",
          "depends_on": [
            "catalog"
          ]
        }
      ]
    },
    {
      "id": "local-evidence-processing",
      "name": "Local Evidence Processing",
      "autonomous": true,
      "trigger": "evidence-arrived",
      "description": "Process newly preserved local evidence without requiring a provider poll.",
      "steps": [
        {
          "id": "catalog",
          "capability": "library.catalog.refresh",
          "depends_on": []
        },
        {
          "id": "index",
          "capability": "library.evidence.index",
          "depends_on": [
            "catalog"
          ]
        },
        {
          "id": "contacts",
          "capability": "evidence.contacts.intake",
          "depends_on": [
            "catalog"
          ]
        },
        {
          "id": "accounting",
          "capability": "accounting.extract",
          "depends_on": [
            "catalog"
          ]
        }
      ]
    },
    {
      "id": "security-spamhaus-recovery",
      "name": "Spamhaus Maintenance Recovery",
      "autonomous": true,
      "trigger": "team-attention",
      "description": "Retry the existing Spamhaus refresh through its bounded maintenance service.",
      "steps": [
        {
          "id": "retry",
          "capability": "security.spamhaus.refresh",
          "depends_on": []
        }
      ]
    },
    {
      "id": "security-suricata-recovery",
      "name": "Suricata Maintenance Recovery",
      "autonomous": true,
      "trigger": "team-attention",
      "description": "Retry the existing Suricata update through its bounded maintenance service.",
      "steps": [
        {
          "id": "retry",
          "capability": "security.suricata.update",
          "depends_on": []
        }
      ]
    },
    {
      "id": "automation-health-recovery",
      "name": "Automation Health Recovery",
      "autonomous": true,
      "trigger": "team-attention",
      "description": "Run bounded service self-healing and then re-audit automation health.",
      "steps": [
        {
          "id": "self-heal",
          "capability": "automation.self_heal",
          "depends_on": []
        },
        {
          "id": "watchdog",
          "capability": "automation.watchdog.run",
          "depends_on": [
            "self-heal"
          ]
        }
      ]
    },
    {
      "id": "mail-release-processing",
      "name": "Released Mail Processing",
      "autonomous": true,
      "trigger": "mail-released",
      "description": "Extract contacts, file documents, then refresh accounting intake from released mail.",
      "steps": [
        {
          "id": "contacts",
          "capability": "mail.contacts.intake",
          "depends_on": []
        },
        {
          "id": "filing",
          "capability": "mail.document.filing",
          "depends_on": []
        },
        {
          "id": "accounting",
          "capability": "accounting.intake",
          "depends_on": [
            "filing"
          ]
        }
      ]
    },
    {
      "id": "executive-reporting-cycle",
      "name": "Executive Reporting Cycle",
      "autonomous": true,
      "trigger": "executive-reporting",
      "description": "Refresh evidence/backup posture and generate executive briefings.",
      "steps": [
        {
          "id": "intelligence",
          "capability": "ava.operations_intelligence.refresh",
          "depends_on": []
        },
        {
          "id": "evidence",
          "capability": "evidence.integrity.audit",
          "depends_on": []
        },
        {
          "id": "backup",
          "capability": "backup.verify",
          "depends_on": []
        },
        {
          "id": "daily",
          "capability": "report.daily.generate",
          "depends_on": [
            "evidence",
            "backup",
            "intelligence"
          ]
        },
        {
          "id": "weekly",
          "capability": "report.weekly.generate",
          "depends_on": [
            "evidence",
            "backup",
            "intelligence"
          ]
        }
      ]
    }
  ],
  "attention_workflows": {
    "edge1-spamhaus-refresh": "security-spamhaus-recovery",
    "wwcx-suricata-update": "security-suricata-recovery",
    "automation-watchdog": "automation-health-recovery"
  }
}
